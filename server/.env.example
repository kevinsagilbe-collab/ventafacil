# Copia este archivo como .env y completa los valores

PORT=3000

# Service URI de Aiven (MySQL) SIN "?ssl-mode=REQUIRED" (el SSL se configura en src/config/db.js)
DATABASE_URL=mysql://avnadmin:CONTRASEÑA@HOST.aivencloud.com:PUERTO/defaultdb

# Certificado CA que descargas desde la consola de Aiven (recomendado).
# Local: ruta al archivo. En Vercel no hay archivo: pega su contenido completo en DB_CA_CERT.
# Si no defines ninguno, la conexión va cifrada pero sin verificar el certificado.
DB_CA_CERT_PATH=./ca.pem
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173
