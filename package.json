{
  "name": "ventafacil",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "seed:historial": "npm run seed:historial -w server --",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
